<!-- Square, stacked: art · text · buttons, for narrow sizes tall enough to stack.
     The art takes whatever height the text and buttons leave. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/astra_widget_shell"
  android:clipToOutline="true">

  <ImageView
    android:id="@+id/astra_widget_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no"
    android:scaleType="fitXY"
    android:src="@drawable/astra_widget_fill" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
      android:id="@+id/astra_widget_art"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:contentDescription="Album art"
      android:scaleType="fitCenter"
      android:src="@drawable/astra_widget_art_placeholder" />

    <TextView
      android:id="@+id/astra_widget_title"
      style="@style/AstraWidget.Title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="Astra" />

    <TextView
      android:id="@+id/astra_widget_artist"
      style="@style/AstraWidget.Artist"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Tap to play" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:layout_marginTop="10dp"
      android:gravity="center_vertical"
      android:orientation="horizontal">

      <ImageView
        android:id="@+id/astra_widget_previous"
        style="@style/AstraWidget.Skip"
        android:contentDescription="Previous"
        android:src="@drawable/astra_widget_ic_previous" />

      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

      <FrameLayout
        android:id="@+id/astra_widget_play_pause"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Play">

        <ImageView
          android:id="@+id/astra_widget_play_bg"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:src="@drawable/astra_widget_play_circle" />

        <ImageView
          android:id="@+id/astra_widget_play_icon"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:importantForAccessibility="no"
          android:padding="12dp"
          android:scaleType="fitCenter"
          android:src="@drawable/astra_widget_ic_play" />
      </FrameLayout>

      <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />

      <ImageView
        android:id="@+id/astra_widget_next"
        style="@style/AstraWidget.Skip"
        android:contentDescription="Next"
        android:src="@drawable/astra_widget_ic_next" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
